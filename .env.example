# Copy to .env and fill in what you use. Never commit a real .env.
# Defaults (no keys) run the system fully offline with fake embeddings
# and the mock LLM — see README for the upgrade path.

# --- data ---
EKI_DATA_DIR=./data

# --- embeddings: fake | huggingface | openai ---
EKI_EMBEDDING_PROVIDER=fake
EKI_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EKI_EMBEDDING_DIM=384

# --- LLM: mock | openai | huggingface ---
EKI_LLM_PROVIDER=mock
EKI_LLM_MODEL=gpt-4o-mini
EKI_LLM_TEMPERATURE=0
# OPENAI_API_KEY=sk-...

# --- chunking: fixed | semantic ---
EKI_CHUNK_SIZE=800
EKI_CHUNK_OVERLAP=120
EKI_CHUNKING_STRATEGY=fixed

# --- retrieval ---
EKI_TOP_K=8
EKI_RERANK_TOP_N=5
EKI_DENSE_WEIGHT=0.6
EKI_BM25_WEIGHT=0.4
EKI_USE_RERANKER=true
EKI_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- vector store: faiss | chroma ---
EKI_VECTOR_STORE=faiss

# --- api ---
EKI_API_HOST=127.0.0.1
EKI_API_PORT=8000
